🧱 CompositeIterator (for reference)
class CompositeIterator implements Iterator<FileSystemComponent> {
    Stack<Iterator<FileSystemComponent>> stack = new Stack<>();

    CompositeIterator(Iterator<FileSystemComponent> iterator) {
        stack.push(iterator);
    }

    public boolean hasNext() {
        while (!stack.isEmpty()) {
            Iterator<FileSystemComponent> itr = stack.peek();
            if (itr.hasNext()) {
                return true;
            }
            stack.pop();
        }
        return false;
    }

    public FileSystemComponent next() {
        if (hasNext()) {
            Iterator<FileSystemComponent> itr = stack.peek();
            FileSystemComponent component = itr.next();
            stack.push(component.createIterator());
            return component;
        }
        return null;
    }
}

